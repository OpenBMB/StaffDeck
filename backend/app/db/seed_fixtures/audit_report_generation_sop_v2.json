        "required_knowledge_base_ids": []
      }
    }
  ],
  "edges": [
    {"source_node_id": "select_or_create_audit_case", "next_node_id": "collect_materials", "priority": 0},
    {"source_node_id": "collect_materials", "next_node_id": "ingest_and_validate_materials", "priority": 0},
    {"source_node_id": "ingest_and_validate_materials", "next_node_id": "build_material_evidence_ledger", "priority": 0},
    {"source_node_id": "build_material_evidence_ledger", "next_node_id": "retrieve_reference_knowledge", "priority": 0},
    {"source_node_id": "retrieve_reference_knowledge", "next_node_id": "trim_template", "priority": 0},
    {"source_node_id": "trim_template", "next_node_id": "generate_report_sections", "priority": 0},
    {"source_node_id": "generate_report_sections", "next_node_id": "consistency_and_coverage_check", "priority": 0},
    {"source_node_id": "consistency_and_coverage_check", "next_node_id": "output_and_confirm", "priority": 0},
    {"source_node_id": "output_and_confirm", "next_node_id": "handoff_lead_auditor", "priority": 0}
  ],
  "start_node_id": "select_or_create_audit_case",
  "terminal_node_ids": ["handoff_lead_auditor"],
  "interruption_policy": {
    "resume": "reuse_audit_case_material_manifest",
    "missing_materials": "ask_only_for_missing_or_failed_items",
    "version_conflict": "pause_and_confirm_current_version"
  }
}
