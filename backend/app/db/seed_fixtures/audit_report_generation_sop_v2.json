{
  "skill_id": "audit_report_generation_sop",
  "name": "项目驱动的审核报告生成",
  "version": "2.0.0",
  "business_domain": "能源管理体系审核",
  "description": "基于审核项目材料清单、完整证据台账、模板和知识库引用生成可追溯的审核报告。",
  "capability_scope": "general",
  "step_timeout_seconds": 600,
  "trigger_intents": [
    "生成审核报告",
    "编写审核报告",
    "根据审核资料形成审核报告"
  ],
  "user_utterance_examples": [
    "请根据这个审核项目的全部资料生成审核报告",
    "继续生成上次项目的审核报告"
  ],
  "goal": [
    "复用已登记的审核项目材料，不因跨对话而要求用户重复上传当前有效文件",
    "覆盖项目材料全文并建立可追溯的审核证据台账",
    "结合已授权的知识库内容生成结构完整、覆盖可核验的审核报告"
  ],
  "required_info": [
    "audit_case_id",
    "report_type",
    "management_systems",
    "organization_name",
    "material_manifest_status",
    "evidence_coverage_status",
    "knowledge_coverage_status"
  ],
  "slot_filling_policy": {
    "enabled": true,
    "mode": "multi_slot",
    "target_info": [
      "audit_case_id",
      "report_type",
      "management_systems",
      "organization_name",
      "material_manifest_status",
      "evidence_coverage_status",
      "knowledge_coverage_status"
    ],
    "skip_satisfied": true,
    "ask_only_missing": true
  },
  "response_rules": [
    "先读取当前审核项目及其材料清单，再决定是否需要用户补充材料。",
    "不得把已登记且当前版本有效的项目材料要求用户重复上传。",
    "审核报告中的事实、证据和引用必须能够回溯到项目材料或已授权知识库内容。",
    "发现材料解析失败、版本冲突、证据缺口或知识库覆盖不足时，明确列出缺口，不得编造内容。",
    "输出前检查报告章节、审核条款、材料覆盖和知识库引用的一致性。"
  ],
  "nodes": [
    {
      "node_id": "select_or_create_audit_case",
      "type": "collect_info",
      "name": "选择或创建审核项目",
      "instruction": "根据当前会话绑定的 audit_case_id 读取审核项目；若没有绑定项目，创建或选择一个可访问的审核项目并记录其 ID。",
      "expected_user_info": ["audit_case_id"],
      "allowed_actions": [],
      "knowledge_scope": {},
      "capability_refs": {
        "general_skill_ids": [],
        "tool_ids": [],
        "knowledge_base_ids": [],
        "required_general_skill_ids": [],
        "required_tool_ids": [],
        "required_knowledge_base_ids": []
      }
    },
    {
      "node_id": "collect_materials",
      "type": "collect_info",
      "name": "核对项目材料清单",
      "instruction": "先读取 audit_case_id 对应的结构化材料清单；只询问缺失、失败或版本冲突的材料。清单中 status=available 或 processing_status=succeeded 的当前版本不得要求用户重复上传。",
      "expected_user_info": ["material_manifest_status"],
      "allowed_actions": [],
      "knowledge_scope": {},
      "capability_refs": {
        "general_skill_ids": [],
        "tool_ids": [],
        "knowledge_base_ids": [],
        "required_general_skill_ids": [],
        "required_tool_ids": [],
        "required_knowledge_base_ids": []
      }
    },
    {
      "node_id": "ingest_and_validate_materials",
      "type": "collect_info",
      "name": "处理并校验项目材料",
      "instruction": "检查项目材料的当前版本、文件完整性、提取状态和全文可用性；保留原始文件，并将失败项标记为待补充。",
      "expected_user_info": ["material_manifest_status"],
      "allowed_actions": [],
      "knowledge_scope": {},
      "capability_refs": {
        "general_skill_ids": [],
        "tool_ids": [],
        "knowledge_base_ids": [],
        "required_general_skill_ids": [],
        "required_tool_ids": [],
        "required_knowledge_base_ids": []
      }
    },
    {
