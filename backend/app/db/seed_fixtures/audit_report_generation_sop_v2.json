      "name": "建立材料证据台账",
      "instruction": "按材料、页码或段落、审核条款和证据主题建立完整证据台账，保留证据来源、覆盖状态和无法确认的缺口。",
      "expected_user_info": ["evidence_coverage_status"],
      "allowed_actions": [],
      "knowledge_scope": {},
      "capability_refs": {
        "general_skill_ids": [],
        "tool_ids": [],
        "knowledge_base_ids": [],
        "required_general_skill_ids": [],
        "required_tool_ids": [],
        "required_knowledge_base_ids": []
      }
    },
    {
      "node_id": "retrieve_reference_knowledge",
      "type": "collect_info",
      "name": "检索适用知识库",
      "instruction": "根据审核范围、管理体系和报告章节检索当前授权知识库，记录命中的文档、版本、条款和引用位置；知识库未覆盖时明确标记。",
      "expected_user_info": ["knowledge_coverage_status"],
      "allowed_actions": [],
      "knowledge_scope": {},
      "capability_refs": {
        "general_skill_ids": [],
        "tool_ids": [],
        "knowledge_base_ids": [],
        "required_general_skill_ids": [],
        "required_tool_ids": [],
        "required_knowledge_base_ids": []
      }
    },
    {
      "node_id": "trim_template",
      "type": "collect_info",
      "name": "准备审核报告模板",
      "instruction": "根据 report_type、management_systems 和组织信息确定报告模板及章节结构；不得删除已建立的证据来源和覆盖标记。",
      "expected_user_info": ["report_type", "management_systems", "organization_name"],
      "allowed_actions": [],
      "knowledge_scope": {},
      "capability_refs": {
        "general_skill_ids": [],
        "tool_ids": [],
        "knowledge_base_ids": [],
        "required_general_skill_ids": [],
        "required_tool_ids": [],
        "required_knowledge_base_ids": []
      }
    },
    {
      "node_id": "generate_report_sections",
      "type": "collect_info",
      "name": "生成审核报告章节",
      "instruction": "依据完整项目材料、证据台账、模板和知识库引用逐章生成报告；每个关键判断都要保留可追溯的材料或知识库依据。",
      "expected_user_info": ["evidence_coverage_status", "knowledge_coverage_status"],
      "allowed_actions": [],
      "knowledge_scope": {},
      "capability_refs": {
        "general_skill_ids": [],
        "tool_ids": [],
        "knowledge_base_ids": [],
        "required_general_skill_ids": [],
        "required_tool_ids": [],
        "required_knowledge_base_ids": []
      }
    },
    {
      "node_id": "consistency_and_coverage_check",
      "type": "collect_info",
      "name": "检查一致性与覆盖率",
      "instruction": "检查报告章节是否覆盖全部适用审核范围，材料证据与结论是否一致，知识库引用是否对应当前版本，并列出所有未解决缺口。",
      "expected_user_info": ["evidence_coverage_status", "knowledge_coverage_status"],
      "allowed_actions": [],
      "knowledge_scope": {},
      "capability_refs": {
        "general_skill_ids": [],
        "tool_ids": [],
        "knowledge_base_ids": [],
        "required_general_skill_ids": [],
        "required_tool_ids": [],
        "required_knowledge_base_ids": []
      }
    },
    {
