      "type": "collect_info",
      "name": "移交审核组长",
      "instruction": "将最终报告、证据台账、材料清单、知识库引用和未解决缺口整理为可复核交付物，提交审核组长确认。",
      "expected_user_info": [],
      "allowed_actions": [],
      "knowledge_scope": {},
      "capability_refs": {
        "general_skill_ids": [],
        "tool_ids": [],
