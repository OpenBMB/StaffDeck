# ===== 阿里云 AI Gateway（API Key 审批分配用）=====
# 本地演示：不配置 AK/SK 时自动走 MOCK 数据（create_consumer / 配额规则返回 mock id，
# 网关列表返回示例网关），无需任何真实资源即可跑通审批分配流程。
# 上生产：设 AIGW_USE_MOCK="0" 并填真实 AK/SK + 网关 ID。
# AIGW_USE_MOCK="1"
# ALIYUN_ACCESS_KEY_ID=""
# ALIYUN_ACCESS_KEY_SECRET=""
# ALIYUN_REGION="cn-hangzhou"
# ALIYUN_APIG_HOST="apig.cn-hangzhou.aliyuncs.com"
# 多网关列表（审批时下拉选择，分配 API Key 用）：name / gateway_id / gateway_url / region
# 以下为示例数据，取消注释即可本地看到网关下拉项；不配置时 mock 模式也会给 2 个示例网关。
# ALIYUN_APIG_GATEWAYS='[{"name":"主力网关","gateway_id":"gw-xxxxxxxx","gateway_url":"https://apigw-xxxxxxxx.aliyuncs.com/v1","region":"cn-hangzhou"},{"name":"备用网关","gateway_id":"gw-yyyyyyyy","gateway_url":"https://apigw-yyyyyyyy.aliyuncs.com/v1","region":"cn-hangzhou"}]'
# 单网关（兼容旧用法，可选）：ALIYUN_APIG_GATEWAY_ID=""  ALIYUN_APIG_QUOTA_RULE_ID=""  ALIYUN_APIG_SUBJECT_ID=""

# ===== 模型预设（新建/编辑模型时的 Model 下拉选项）=====
# JSON 数组字符串，配置固定的几个模型供前端下拉选择，用户无需手动填写。
# 未配置时使用内置默认列表，保证下拉始终有值。
MODEL_PRESETS='["deepseek-v4-flash", "glm-5.2", "qwen3.8-27b"]'

# ===== 消费组「归属」选项（API Key 审批 → 消费组管理）=====
# JSON 数组字符串，配置消费组业务归属的下拉选项（非阿里云接口字段）。
# 未配置时使用内置默认列表：["重庆项目","复星总部IT","Club Med"]。
# CONSUMER_GROUP_OWNERS='["重庆项目","复星总部IT","Club Med"]'

# ===== Laya 决策服务（「决策助手」页面）=====
# Convai Laya Decision API。前端不直连该地址：目标服务未挂 CORS 中间件（OPTIONS 预检 405），
# 且地址属服务端内网，统一由后端 /api/enterprise/laya/* 代理转发。
# LAYA_PREDICT_URL="http://8.153.146.109:8080/predict"
# LAYA_TIMEOUT_SECONDS="60"
#
# 把 Laya 决策头接入 SOP 走向决策（见 .planning/quick/261008-jfj 的修改计划）：
# 结构化边条件（EdgeConditionSpec）判不了时，用 Laya 做一次出边抉择，替代一整轮
# task_action 主模型决策；低置信/超时/非法答案一律回退，行为不劣化。
# 优先级固定为「确定性 spec > Laya > 主模型 LLM」。默认关闭。
# LAYA_SOP_ROUTING_ENABLED="false"
# 先开影子模式：照常计算并记录、但不改变路由，用于先看与主模型的一致率。
# LAYA_SOP_SHADOW_MODE="true"
# choice/score 赢家概率、noul 的 max(p,1-p)；低于该值回退主模型。
# LAYA_MIN_CONFIDENCE="0.7"
# 路由专用短超时（秒），与「决策助手」的 60s 分开，避免拖慢对话链路。
# LAYA_SOP_TIMEOUT_SECONDS="6"
# 连续失败达到该次数后本帧熔断，后续节点直接回退 LLM。
# LAYA_SOP_CIRCUIT_BREAKER_FAILURES="3"
#
# 把 Laya 决策头接入知识路由（选文档 / 选桶，P2'，见 .planning/quick/261008-jfj
# 的 P2 改动清单）：确定性路径（缓存 / 小候选短路 / 词法 fast path）拦不住、
# 真要调模型分类时，先用 Laya 逐候选判「是否相关」（noul）再取 top-k，
# 判不了一律回退现有 LLM。优先级固定为「确定性路径 > Laya > 现有 LLM」。默认关闭。
# LAYA_KNOWLEDGE_ROUTE_ENABLED="false"
# 先开影子模式：照常计算并记录、但不采用，用于看与 LLM 的一致率。
# LAYA_KNOWLEDGE_SHADOW_MODE="true"
# 候选数超过该值直接回退 LLM（Laya 逐候选问，候选多时多次调用不划算）。
# LAYA_KNOWLEDGE_MAX_CANDIDATES="30"
# 单次 /predict 携带的问题数上限（≤ 上游 MAX_QUESTIONS=30）。
# LAYA_KNOWLEDGE_QUESTIONS_PER_CALL="30"
# 知识路由专用短超时（秒），与 SOP 旁路、页面「决策助手」60s 各自独立。
# LAYA_KNOWLEDGE_TIMEOUT_SECONDS="6"

# ===== 对外基址（开放 API 示例里的 host）=====
# 决策助手「API 接入」弹窗生成的调用示例用这个地址当 host。
# 部署在域名 / 公网 IP 后面时填它；留空则回退成浏览器当前 origin（本地开发即 http://127.0.0.1:5173）。
# PUBLIC_BASE_URL="https://staffdeck.example.com"

# ===== AI Reviewer（代码评审，ocr CLI）=====
# 服务器需先安装 ocr：npm install -g @alibaba-group/open-code-review（或把
# AI_REVIEW_OCR_BINARY 指向可执行文件路径）。评审跑在 rq worker 上。
# AI_REVIEW_QUEUE="ai_review"
# AI_REVIEW_JOB_TIMEOUT_SECONDS="1800"
# AI_REVIEW_OCR_BINARY="ocr"
# 评审用的 LLM（经 OCR_LLM_URL / OCR_LLM_TOKEN / OCR_LLM_MODEL 注入 ocr 子进程）。
# AI_REVIEW_LLM_URL=""            # 例如 https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# AI_REVIEW_LLM_TOKEN=""
# AI_REVIEW_LLM_MODEL=""          # 例如 deepseek-v4-pro
# AI_REVIEW_LLM_USE_ANTHROPIC="false"   # Anthropic 兼容端点置 true
# AI_REVIEW_LANGUAGE="中文"        # 评审意见语言（ocr config set language）

# ===== OCR 助手（Agent 广场「OCR 助手」，Indra OCR 服务）=====
# 注意与上面的 AI_REVIEW_OCR_* 无关：那是代码评审用的 ocr CLI，
# 这里是一个独立的 OCR HTTP 服务（契约见仓库根目录 indra.md）。
# 上游要求 X-API-Key，所以必须由后端代理，前端不持有密钥。
# INDRA_OCR_BASE_URL="http://127.0.0.1:8000"   # 默认值对齐 indra.md 的本地样例
# INDRA_OCR_API_KEY=""                          # 上游要鉴权时填；留空则不带 X-API-Key
# INDRA_OCR_TIMEOUT_SECONDS="300"               # 扫描件按页识别，给得比普通接口宽
# INDRA_OCR_MAX_FILES="10"                      # 单次请求的文件数上限
# INDRA_OCR_MAX_FILE_MB="50"                    # 单文件体积上限
